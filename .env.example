# Copy to `.env.local`. Never put seed phrases or private keys here.
# Values marked NEXT_PUBLIC_* are visible in the browser. Keep secrets in the others.

# -----------------------------------------------------------------------------
# App URL
# -----------------------------------------------------------------------------
# Where this app is reachable. Used for TokenPocket callbacks and referral links.
# Local: http://localhost:3000
# Same Wi‑Fi phone / TokenPocket: http://YOUR_LAN_IP:3000  e.g. http://192.168.29.216:3000
# TokenPocket cannot call localhost on your laptop. Then restart npm run dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Network (keep Amoy for development)
# -----------------------------------------------------------------------------
# amoy = Polygon testnet chain id 80002
# mainnet = Polygon chain id 137
NEXT_PUBLIC_NETWORK=amoy
NEXT_PUBLIC_DEMO_MODE=true
# Must be exactly true to allow payments on mainnet. Leave false in development.
MAINNET_PAYMENTS=false

# Optional explorer bases (defaults are Polygonscan).
POLYGON_AMOY_EXPLORER_URL=https://amoy.polygonscan.com
POLYGON_EXPLORER_URL=https://polygonscan.com

# -----------------------------------------------------------------------------
# Session cookie (required)
# -----------------------------------------------------------------------------
# iron-session password. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# -----------------------------------------------------------------------------
# Admin login for /admin
# -----------------------------------------------------------------------------
# Username can be any string you choose. Password is required.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional aliases:
# ADMIN_BOOTSTRAP_USERNAME=
# ADMIN_BOOTSTRAP_PASSWORD=

# -----------------------------------------------------------------------------
# Supabase (optional)
# -----------------------------------------------------------------------------
# If empty, the app uses data/globalx.json. Do not create a second database.
# Create a project: https://supabase.com/dashboard  → Project Settings → API
# Project URL only, e.g. https://xxxx.supabase.co  (do not append /rest/v1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Polygon RPC
# -----------------------------------------------------------------------------
# Public endpoints are rate-limited. Prefer Alchemy, Infura, QuickNode, or dRPC.
# Amoy: https://polygon-amoy.drpc.org is a fallback if this is empty.
POLYGON_AMOY_RPC_URL=https://polygon-amoy.drpc.org
POLYGON_RPC_URL=

# -----------------------------------------------------------------------------
# USDT ERC-20 contracts — do not invent addresses
# -----------------------------------------------------------------------------
# Paste a contract you verified yourself (Amoy test token or official Polygon USDT).
# If POLYGON_AMOY_USDT_CONTRACT is empty, the UI shows:
#   "USDT testnet contract is not configured."
# Payments will not succeed and the app will not fake a success.
POLYGON_AMOY_USDT_CONTRACT=
POLYGON_USDT_CONTRACT=

# -----------------------------------------------------------------------------
# Payment recipient (server only — never chosen by the frontend)
# -----------------------------------------------------------------------------
# Treasury / company wallet that receives registration and plan ERC-20 transfers.
PAYMENT_RECIPIENT_ADDRESS=
